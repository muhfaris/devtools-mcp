# Database - one variable per connection named in .devtools/config.yaml
DEV_DATABASE_URL=postgresql://user:password@localhost:5432/mydb
STAGING_DATABASE_URL=postgresql://user:password@localhost:5432/mydb_staging
# PROD_DATABASE_URL=postgresql://user:password@prod-host:5432/mydb

# Redis
REDIS_URL=redis://localhost:6379/0

# GitLab
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Gate for `cmd:` values in .devtools/config.yaml. Denied by default; a config file
# cannot grant it, only the environment the server is launched with can.
# DEVTOOLS_ALLOW_CMD=1
