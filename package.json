{
  "name": "@muhfaris/devtools",
  "version": "0.1.2",
  "description": "DevTools MCP - Developer companion for AI assistants",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhfaris/devtools-mcp.git"
  },
  "homepage": "https://github.com/muhfaris/devtools-mcp#readme",
  "bugs": {
    "url": "https://github.com/muhfaris/devtools-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
